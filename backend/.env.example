# ---------------------------------------------------------------------------
# Copy to backend/.env and edit, or just export these before starting uvicorn.
# Every value here has a working default; nothing is required.
# ---------------------------------------------------------------------------

# lite | balanced | quality   (see app/config.py for what each one picks)
MODEL_PROFILE=balanced

# Override any single model without changing the profile
# STT_MODEL=vasista22/whisper-hindi-medium
# TTS_MODEL=ai4bharat/IndicF5
# TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
# EMBEDDER_MODEL=intfloat/multilingual-e5-base
# INTENT_BASE_MODEL=google/muril-base-cased

# auto | cpu | cuda
DEVICE=auto

# Turn individual models off. With all four off the API still answers through
# the keyword router - useful for UI work and for CI.
ENABLE_STT=1
ENABLE_TTS=1
ENABLE_TRANSLATE=1
ENABLE_EMBEDDER=1

# Load models at startup instead of on first use. Slower boot, no first-question
# stall - worth it right before a live demo.
EAGER_LOAD_MODELS=0

# IndicF5 is a voice-cloning model: it needs a short reference clip and the
# exact transcript of that clip.
# INDICF5_REF_AUDIO=./assets/ref_audio/hindi_ref.wav
# INDICF5_REF_TEXT=नमस्ते, मैं आपकी मशीन सहायक हूँ।

# server
PORT=8000
CORS_ORIGINS=*
JWT_SECRET=change-me-in-production
